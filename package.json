{
  "name": "janotate",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samishal1998/janotate.git"
  },
  "homepage": "https://samishal1998.github.io/janotate/",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "janotate": "bin/janotate.mjs"
  },
  "scripts": {
    "build": "vite build packages/ui && cd packages/docs && ASTRO_TELEMETRY_DISABLED=1 astro build && cd ../.. && node scripts/build.mjs",
    "test": "node --test tests/*.test.ts",
    "lint": "npx --yes oxlint@1.93.0 packages/core/src packages/server/src packages/ui/src scripts bin tests",
    "typecheck": "tsc --noEmit",
    "test:wait": "node tests/wait.long.ts",
    "screenshots": "node scripts/screenshots.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "diff": "9.0.0",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.42.6",
    "@base-ui/react": "1.9.0",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.42.1",
    "@dagrejs/dagre": "3.1.3",
    "@dbml/parse": "12.1.0",
    "@lezer/highlight": "1.2.3",
    "@samyx/publish-kit": "0.0.0-pre.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "https://registry.npmjs.org/@types/react/-/react-19.2.18.tgz",
    "@types/react-dom": "https://registry.npmjs.org/@types/react-dom/-/react-dom-19.2.5.tgz",
    "@xyflow/react": "13.0.2",
    "astro": "7.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csstype": "https://registry.npmjs.org/csstype/-/csstype-3.2.3.tgz",
    "lottie-web": "5.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-diff-view": "3.3.3",
    "react-dom": "19.2.8",
    "rolldown": "1.2.16",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  },
  "overrides": {
    "rolldown": "1.2.16"
  },
  "files": [
    "bin",
    "dist"
  ]
}
